<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RollForward>LatestMajor</RollForward>
    <Version>0.2.29</Version>
    <AssemblyVersion>0.2.29.0</AssemblyVersion>
    <FileVersion>0.2.29.0</FileVersion>
    <InformationalVersion>0.2.29</InformationalVersion>
    <DefaultItemExcludes>$(DefaultItemExcludes);WIB\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WPF-UI" Version="4.0.3" />
  </ItemGroup>

</Project>
