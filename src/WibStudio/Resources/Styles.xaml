<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:res="clr-namespace:WibStudio.Resources"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- Converters -->
    <res:RiskToBrushConverter x:Key="RiskToBrushConverter" />
    <res:LogLevelToBrushConverter x:Key="LogLevelToBrushConverter" />
    <res:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <res:LowDiskToBrushConverter x:Key="LowDiskToBrushConverter" />

    <!-- Fluent 2 Brushes -->
    <SolidColorBrush x:Key="WibPrimaryAccent" Color="#0078D4" />
    <SolidColorBrush x:Key="WibAccentHover" Color="#106EBE" />
    <SolidColorBrush x:Key="WibTerminalBg" Color="#181B20" />
    <SolidColorBrush x:Key="WibTerminalBorder" Color="#2D3239" />
    <SolidColorBrush x:Key="WibTerminalText" Color="#E2E8F0" />
    <SolidColorBrush x:Key="WibCardBorder" Color="#2D3239" />
    <SolidColorBrush x:Key="WibTextMuted" Color="#94A3B8" />
    <SolidColorBrush x:Key="WibElevatedGreen" Color="#16A34A" />
    <SolidColorBrush x:Key="WibStandardAmber" Color="#D97706" />
    <SolidColorBrush x:Key="WibDangerRed" Color="#DC2626" />

    <!-- Fluent 2 Card Style -->
    <Style x:Key="WibCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Subtitle Text Style -->
    <Style x:Key="WibSectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, sans-serif" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="WibFieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- Modern Sleek Terminal ScrollBar Style -->
    <Style x:Key="WibTerminalThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="#334155"
                            CornerRadius="4"
                            Margin="1,0" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#475569" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter Property="Background" Value="#64748B" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WibTerminalScrollBarStyle" TargetType="{x:Type ScrollBar}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource WibTerminalThumbStyle}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
