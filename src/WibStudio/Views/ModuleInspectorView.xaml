<UserControl x:Class="WibStudio.Views.ModuleInspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:WibStudio.Models"
             xmlns:vm="clr-namespace:WibStudio.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:ModuleInspectorViewModel}"
             d:DesignHeight="850" d:DesignWidth="1200">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header & Filter Bar -->
            <RowDefinition Height="Auto" />
            <!-- 1: Interactive Data Table (Top 65%) -->
            <RowDefinition Height="65*" />
            <!-- 2: Splitter -->
            <RowDefinition Height="8" />
            <!-- 3: Detail Card (Bottom 35%) -->
            <RowDefinition Height="35*" />
        </Grid.RowDefinitions>

        <!-- Header & Filter Bar Card -->
        <Border Grid.Row="0"
                Style="{StaticResource WibCardStyle}"
                Padding="16,12"
                Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title & Profile Selector -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Module Catalog &amp; Architecture" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Catalog of all 19 offline Windows 11 servicing modules, risk ratings, reversibility journals, and verification hooks."
                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Active Profile Selector -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Simulate Profile:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ComboBox ItemsSource="{Binding Profiles}"
                                  SelectedItem="{Binding SelectedProfile}"
                                  DisplayMemberPath="DisplayName"
                                  Width="240" />
                    </StackPanel>
                </Grid>

                <!-- Search & Filter Controls -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Search Input -->
                    <ui:TextBox Grid.Column="0"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Search by module ID, name, category, or description..."
                                Icon="{ui:SymbolIcon Symbol=Search24}" />

                    <!-- Risk Filter -->
                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding RiskFilters}"
                              SelectedItem="{Binding SelectedRiskFilter}" />

                    <!-- Reset Filter -->
                    <ui:Button Grid.Column="4"
                               Content="Reset"
                               Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}"
                               Command="{Binding ClearSearchCommand}" />
                </Grid>
            </Grid>
        </Border>

        <!-- Interactive Data Table (Top 65%) -->
        <Border Grid.Row="1"
                Style="{StaticResource WibCardStyle}"
                Padding="0"
                Margin="0,0,0,0">
            <DataGrid ItemsSource="{Binding FilteredModules}"
                      SelectedItem="{Binding SelectedModule}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      BorderThickness="0"
                      Background="Transparent"
                      RowHeaderWidth="0">
                <DataGrid.Columns>
                    <!-- Status -->
                    <DataGridTemplateColumn Header="Status" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:ServicingModule}">
                                <Border Margin="6,2" CornerRadius="10" Padding="8,2" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="#1E3A2B" />
                                                    <Setter Property="BorderBrush" Value="#16A34A" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="Background" Value="#2D3239" />
                                                    <Setter Property="BorderBrush" Value="#4B5563" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Text" Value="ACTIVE" />
                                                        <Setter Property="Foreground" Value="#4ADE80" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Text" Value="OFF" />
                                                        <Setter Property="Foreground" Value="#94A3B8" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Module ID -->
                    <DataGridTextColumn Header="Module ID" Binding="{Binding Id}" Width="160" FontWeight="SemiBold" />

                    <!-- Name -->
                    <DataGridTextColumn Header="Module Name" Binding="{Binding Name}" Width="210" FontWeight="Medium" />

                    <!-- Risk Badge -->
                    <DataGridTemplateColumn Header="Risk" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:ServicingModule}">
                                <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Center"
                                        Background="#242830" BorderThickness="1"
                                        BorderBrush="{Binding Risk, Converter={StaticResource RiskToBrushConverter}}">
                                    <TextBlock Text="{Binding RiskBadge}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding Risk, Converter={StaticResource RiskToBrushConverter}}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Scope -->
                    <DataGridTemplateColumn Header="Scope" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:ServicingModule}">
                                <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Center" Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1">
                                    <TextBlock Text="{Binding ScopeBadge}" FontSize="11" Foreground="#38BDF8" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Reversibility -->
                    <DataGridTextColumn Header="Reversibility" Binding="{Binding ReversibilityBadge}" Width="140" />

                    <!-- Category -->
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120" />

                    <!-- Description & Trade-offs -->
                    <DataGridTextColumn Header="Description &amp; Trade-offs" Binding="{Binding Description}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Grid Splitter -->
        <GridSplitter Grid.Row="2"
                      Height="4"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      Background="{DynamicResource CardStrokeColorDefaultBrush}"
                      Cursor="SizeNS" />

        <!-- Detail Card (Bottom 35%) -->
        <Border Grid.Row="3"
                Style="{StaticResource WibCardStyle}"
                Padding="16,12"
                Margin="0,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel DataContext="{Binding SelectedModule}">
                    <!-- Module Title & Badges Header -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Id}"
                                           FontFamily="Cascadia Code, Consolas"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource WibPrimaryAccent}"
                                           Margin="0,0,10,0" />
                                <TextBlock Text="{Binding Name}"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Category}" FontSize="11" Foreground="#94A3B8" />
                        </StackPanel>

                        <!-- Right Badges -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Risk -->
                            <Border CornerRadius="10" Padding="10,3" Margin="0,0,8,0"
                                    Background="#242830" BorderThickness="1"
                                    BorderBrush="{Binding Risk, Converter={StaticResource RiskToBrushConverter}}">
                                <TextBlock Text="{Binding RiskBadge}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{Binding Risk, Converter={StaticResource RiskToBrushConverter}}" />
                            </Border>

                            <!-- Scope -->
                            <Border CornerRadius="10" Padding="10,3" Margin="0,0,8,0" Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1">
                                <TextBlock Text="{Binding ScopeBadge}" FontSize="11" Foreground="#38BDF8" />
                            </Border>

                            <!-- Reversibility -->
                            <Border CornerRadius="10" Padding="10,3" Background="#2E1065" BorderBrush="#C084FC" BorderThickness="1">
                                <TextBlock Text="{Binding ReversibilityBadge}" FontSize="11" Foreground="#C084FC" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Description -->
                    <TextBlock Text="Description &amp; Servicing Action" Style="{StaticResource WibFieldLabelStyle}" />
                    <TextBlock Text="{Binding Description}"
                               FontSize="12.5"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10" />

                    <!-- Two-column: Trade-Offs & Security Implications -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Trade-offs -->
                        <Border Grid.Column="0" Background="#1F2329" CornerRadius="6" Padding="12,8" BorderBrush="#2D3239" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Trade-Offs &amp; Impact" FontWeight="SemiBold" FontSize="11.5" Foreground="#F59E0B" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding TradeOffs}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Security -->
                        <Border Grid.Column="2" Background="#1F2329" CornerRadius="6" Padding="12,8" BorderBrush="#2D3239" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Security &amp; Privacy Implications" FontWeight="SemiBold" FontSize="11.5" Foreground="#38BDF8" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding SecurityImplications}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Target Registry Keys & Verification Hook -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Registry Keys -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Target Offline Registry Keys / DISM Policies" Style="{StaticResource WibFieldLabelStyle}" />
                            <Border Background="{StaticResource WibTerminalBg}" BorderBrush="{StaticResource WibTerminalBorder}" BorderThickness="1" CornerRadius="6" Padding="10">
                                <ItemsControl ItemsSource="{Binding TargetRegistryKeys}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       FontFamily="Cascadia Code, Consolas"
                                                       FontSize="11"
                                                       Foreground="#A5B4FC"
                                                       Margin="0,2"
                                                       TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>

                        <!-- Verification Hook -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Automated Invariant Verification Hook" Style="{StaticResource WibFieldLabelStyle}" />
                            <Border Background="{StaticResource WibTerminalBg}" BorderBrush="{StaticResource WibTerminalBorder}" BorderThickness="1" CornerRadius="6" Padding="10">
                                <TextBlock Text="{Binding VerificationHook}"
                                           FontFamily="Cascadia Code, Consolas"
                                           FontSize="11"
                                           Foreground="#4ADE80"
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
