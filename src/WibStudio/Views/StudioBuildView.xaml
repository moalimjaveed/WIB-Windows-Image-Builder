<UserControl x:Class="WibStudio.Views.StudioBuildView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:WibStudio.Models"
             xmlns:vm="clr-namespace:WibStudio.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:StudioBuildViewModel}"
             d:DesignHeight="800" d:DesignWidth="1200">

    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <!-- 0: Preflight Summary Bar -->
            <RowDefinition Height="Auto" />
            <!-- 1: Quick-Start Beginner Steps Ribbon -->
            <RowDefinition Height="Auto" />
            <!-- 2: Configuration Inputs & Toggles Card -->
            <RowDefinition Height="Auto" />
            <!-- 3: Action Buttons Bar -->
            <RowDefinition Height="Auto" />
            <!-- 4: Activity & Diagnostics Console (Consumes remaining space) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- A. Preflight Summary Bar -->
        <Border Grid.Row="0"
                Style="{StaticResource WibCardStyle}"
                Padding="16,10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Privilege Badge (Subtle Rounded Box matching theme) -->
                <Border Grid.Column="0"
                        Margin="0,0,24,0"
                        CornerRadius="6"
                        Padding="10,4"
                        BorderThickness="1"
                        Background="{Binding PreflightPrivilegeBackground}"
                        BorderBrush="{Binding PreflightPrivilegeBorder}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="{Binding PreflightPrivilegeIconSymbol}"
                                       Foreground="{Binding PreflightPrivilegeForeground}"
                                       FontSize="15"
                                       Margin="0,0,6,0" />
                        <TextBlock Text="{Binding PreflightPrivilege}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding PreflightPrivilegeForeground}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Source ISO -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <ui:SymbolIcon Symbol="Image24" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" />
                    <StackPanel>
                        <TextBlock Text="Source ISO" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding PreflightIsoSummary}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                    </StackPanel>
                </StackPanel>

                <!-- Staging Workspace -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <ui:SymbolIcon Symbol="HardDrive24" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" />
                    <StackPanel>
                        <TextBlock Text="Staging Disk Quota" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding PreflightWorkspaceSummary}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding IsLowDiskSpace, Converter={StaticResource LowDiskToBrushConverter}}" />
                    </StackPanel>
                </StackPanel>

                <!-- Active Profile -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Wrench24" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" />
                    <StackPanel>
                        <TextBlock Text="Active Servicing Profile" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding ActiveProfileSummary}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="300" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Quick-Start Beginner Steps Ribbon (Theme-Adaptive) -->
        <Border Grid.Row="1"
                Background="{Binding QuickStartBackground}"
                BorderBrush="{Binding QuickStartBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16,8"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <ui:SymbolIcon Symbol="Lightbulb24" Foreground="{Binding QuickStartAccentText}" Margin="0,0,8,0" />
                    <TextBlock Text="Quick Start Guide" FontWeight="SemiBold" Foreground="{Binding QuickStartAccentText}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap">
                    <Run Text="Step 1:" FontWeight="Bold" Foreground="{Binding QuickStartAccentText}" />
                    <Run Text=" Click " Foreground="{Binding QuickStartBodyText}" />
                    <Run Text="'Browse ISO...'" FontWeight="SemiBold" Foreground="{Binding QuickStartHighlightText}" />
                    <Run Text=" to pick your official Windows 11 ISO  •  " Foreground="{Binding QuickStartBodyText}" />
                    <Run Text="Step 2:" FontWeight="Bold" Foreground="{Binding QuickStartAccentText}" />
                    <Run Text=" Keep " Foreground="{Binding QuickStartBodyText}" />
                    <Run Text="'balanced'" FontWeight="SemiBold" Foreground="{Binding QuickStartHighlightText}" />
                    <Run Text=" profile (recommended)  •  " Foreground="{Binding QuickStartBodyText}" />
                    <Run Text="Step 3:" FontWeight="Bold" Foreground="{Binding QuickStartAccentText}" />
                    <Run Text=" Click " Foreground="{Binding QuickStartBodyText}" />
                    <Run Text="'Start Build'" FontWeight="Bold" Foreground="{Binding QuickStartSuccessText}" />
                    <Run Text=" below!" Foreground="{Binding QuickStartBodyText}" />
                </TextBlock>
            </Grid>
        </Border>

        <!-- B. Configuration Inputs & C. Options Toggles Card -->
        <Border Grid.Row="2"
                Style="{StaticResource WibCardStyle}"
                Padding="16,14"
                Margin="0,0,0,10"
                IsEnabled="{Binding IsNotBusy}">
            <StackPanel>
                <!-- Source Paths Row -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Source ISO -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Source Windows 11 ISO Image" Style="{StaticResource WibFieldLabelStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0"
                                        Text="{Binding IsoPath, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Click 'Browse ISO...' to choose your Windows 11 ISO file"
                                        Margin="0,0,8,0" />
                            <ui:Button Grid.Column="1"
                                       Content="Browse ISO..."
                                       Icon="{ui:SymbolIcon Symbol=FolderOpen24}"
                                       Command="{Binding BrowseIsoCommand}"
                                       FontWeight="SemiBold"
                                       ToolTip="Select your downloaded official Windows 11 ISO file" />
                        </Grid>
                    </StackPanel>

                    <!-- Staging Workspace -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Staging Workspace Directory (DISM Mount Sandbox)" Style="{StaticResource WibFieldLabelStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0"
                                        Text="{Binding WorkspacePath, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="e.g. C:\WIB\work"
                                        Margin="0,0,8,0" />
                            <ui:Button Grid.Column="1"
                                       Content="Browse..."
                                       Icon="{ui:SymbolIcon Symbol=FolderOpen24}"
                                       Command="{Binding BrowseWorkspaceCommand}" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Three Core Selectors (3 Equal Columns) -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 1. Build Profile -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="1. Build Servicing Profile" Style="{StaticResource WibFieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding Profiles}"
                                  SelectedItem="{Binding SelectedProfile}"
                                  DisplayMemberPath="DisplayName"
                                  HorizontalAlignment="Stretch"
                                  Margin="0,0,0,4" />
                        <TextBlock Text="{Binding ProfileHelperText}"
                                   FontSize="11"
                                   Foreground="{StaticResource WibPrimaryAccent}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- 2. Target Edition -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="2. Target Edition" Style="{StaticResource WibFieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding Editions}"
                                  SelectedItem="{Binding SelectedEdition}"
                                  DisplayMemberPath="DisplayName"
                                  HorizontalAlignment="Stretch"
                                  Margin="0,0,0,4" />
                        <TextBlock Text="{Binding SelectedEdition.Description}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- 3. Hardware Profile -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="3. Hardware Spec Profile" Style="{StaticResource WibFieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding HardwareSpecs}"
                                  SelectedItem="{Binding SelectedHardware}"
                                  DisplayMemberPath="Name"
                                  HorizontalAlignment="Stretch"
                                  Margin="0,0,0,4" />
                        <TextBlock Text="{Binding SelectedHardware.OptimizationsSummary}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <!-- Options & Safety Toggles -->
                <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                    <WrapPanel Orientation="Horizontal">
                        <ui:ToggleSwitch Content="Dry-run simulation only"
                                         IsChecked="{Binding IsDryRun}"
                                         ToolTip="Test the entire servicing pipeline in ~10 seconds without writing changes to disk"
                                         Margin="0,0,24,6" />
                        <ui:ToggleSwitch Content="Resume from checkpoint"
                                         IsChecked="{Binding ResumeFromCheckpoint}"
                                         ToolTip="Resume an interrupted build from the last completed stage instead of starting over"
                                         Margin="0,0,24,6" />
                        <ui:ToggleSwitch Content="Download signed oscdimg"
                                         IsChecked="{Binding DownloadSignedOscdimg}"
                                         ToolTip="Automatically download and verify Microsoft's official oscdimg ISO authoring tool if not already present"
                                         Margin="0,0,24,6" />
                        <ui:ToggleSwitch Content="Accept high-risk modules"
                                         IsChecked="{Binding AcceptHighRiskModules}"
                                         ToolTip="Allow high-risk customizations (such as disabling UAC or Defender). Not recommended for daily PCs."
                                         Margin="0,0,24,6" />
                        <ui:ToggleSwitch Content="Fast build (skip intermediate checkpoints)"
                                         IsChecked="{Binding FastBuild}"
                                         ToolTip="Recommended: Speeds up servicing significantly by applying all modifications directly and saving once at the end, eliminating multi-gigabyte intermediate WIM snapshots"
                                         Margin="0,0,24,6" />
                        <ui:ToggleSwitch Content="Skip ISO hash verification"
                                         IsChecked="{Binding SkipIsoHashVerification}"
                                         ToolTip="Skip calculating the full SHA-256 hash of the input ISO file (faster dry-run testing)"
                                         Margin="0,0,24,6" />
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- D. Action Buttons Bar -->
        <Border Grid.Row="3" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Action Cluster -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- 1. Start Build (Primary Action - High-Contrast White Text & Icon) -->
                    <ui:Button Command="{Binding StartBuildCommand}"
                               Margin="0,0,12,0"
                               Padding="22,9"
                               ToolTip="Start building your customized, bloat-free Windows 11 installation media">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Background" Value="#0284C7" />
                                <Setter Property="BorderBrush" Value="#0369A1" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#0369A1" />
                                        <Setter Property="BorderBrush" Value="#075985" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#075985" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.6" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Play24" Foreground="#FFFFFF" FontSize="15" Margin="0,0,8,0" />
                            <TextBlock Text="Start Build"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       Foreground="#FFFFFF"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <!-- 2. Preview Plan (Dry Run) -->
                    <ui:Button Content="Preview Plan (Dry Run)"
                               Icon="{ui:SymbolIcon Symbol=DocumentSearch24}"
                               Command="{Binding PreviewPlanCommand}"
                               Margin="0,0,10,0"
                               Padding="16,8"
                               ToolTip="Simulate the servicing pipeline in ~10 seconds without making changes" />

                    <!-- 3. Validate Profile -->
                    <ui:Button Content="Validate Profile"
                               Icon="{ui:SymbolIcon Symbol=CheckmarkCircle24}"
                               Command="{Binding ValidateProfileCommand}"
                               Margin="0,0,10,0"
                               Padding="14,8"
                               ToolTip="Run schema validation on the selected profile" />

                    <!-- 4. Cancel (Danger) -->
                    <ui:Button Content="Cancel"
                               Icon="{ui:SymbolIcon Symbol=Stop24}"
                               Appearance="Danger"
                               Command="{Binding CancelCommand}"
                               Margin="0,0,10,0"
                               Padding="14,8"
                               ToolTip="Halt servicing and release sandbox locks" />

                    <!-- 5. Open Reports -->
                    <ui:Button Content="Open Reports"
                               Icon="{ui:SymbolIcon Symbol=Folder24}"
                               Command="{Binding OpenReportsCommand}"
                               Padding="14,8"
                               ToolTip="Open output reports directory (manifest.json, report.html, journal.reg)" />
                </StackPanel>

                <!-- Right Utility Cluster -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Content="Copy"
                               Icon="{ui:SymbolIcon Symbol=Copy24}"
                               Command="{Binding CopyConsoleCommand}"
                               Margin="0,0,8,0"
                               Padding="12,8"
                               ToolTip="Copy entire console log to clipboard" />
                    <ui:Button Content="Clear"
                               Icon="{ui:SymbolIcon Symbol=Delete24}"
                               Command="{Binding ClearConsoleCommand}"
                               Padding="12,8"
                               ToolTip="Clear console output" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- E. Activity & Diagnostics Console (Takes 100% remaining space) -->
        <Border Grid.Row="4"
                Background="{StaticResource WibTerminalBg}"
                BorderBrush="{StaticResource WibTerminalBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Status & Console Header Row -->
                    <RowDefinition Height="Auto" />
                    <!-- Progress Bar -->
                    <RowDefinition Height="Auto" />
                    <!-- Terminal Console Stream -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Status & Console Header Row -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Console Title, Line Counter, & Status -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Code24" Foreground="#38BDF8" Margin="0,0,8,0" FontSize="16" />
                        <TextBlock Text="SERVICING CONSOLE"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource WibPrimaryAccent}"
                                   VerticalAlignment="Center" />
                        <Border Background="#1E293B" CornerRadius="4" Padding="6,1" Margin="8,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LogEntries.Count, StringFormat='{}{0} lines'}"
                                       FontSize="10.5"
                                       FontWeight="Medium"
                                       Foreground="#94A3B8" />
                        </Border>
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource WibTerminalText}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="520" />
                    </StackPanel>

                    <!-- Right: Elapsed Timer -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Timer24" Foreground="#38BDF8" Margin="0,0,6,0" FontSize="15" />
                        <TextBlock Text="{Binding ElapsedTimeText}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#38BDF8"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Thin 3px Modern Progress Indicator -->
                <ProgressBar Grid.Row="1"
                             Value="{Binding ProgressValue}"
                             Maximum="100"
                             Height="3"
                             Margin="0,0,0,8" />

                <!-- Terminal View with Sleek Modern ScrollBar -->
                <ScrollViewer Grid.Row="2"
                              x:Name="ConsoleScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,2,8,2">
                    <ScrollViewer.Resources>
                        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource WibTerminalScrollBarStyle}" />
                    </ScrollViewer.Resources>
                    <ItemsControl ItemsSource="{Binding LogEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:LogEntry}">
                                <Grid Margin="0,1.5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Timestamp -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding TimestampFormatted}"
                                               FontFamily="Cascadia Code, Consolas, Courier New"
                                               FontSize="11.5"
                                               Foreground="#64748B"
                                               Margin="0,0,10,0" />
                                    <!-- Level Prefix -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding LevelPrefix}"
                                               FontFamily="Cascadia Code, Consolas, Courier New"
                                               FontSize="11.5"
                                               FontWeight="Bold"
                                               Foreground="{Binding Level, Converter={StaticResource LogLevelToBrushConverter}}"
                                               Margin="0,0,10,0" />
                                    <!-- Message Text -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Message}"
                                               FontFamily="Cascadia Code, Consolas, Courier New"
                                               FontSize="11.5"
                                               Foreground="{StaticResource WibTerminalText}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
